{
  "Условная конструкция IF": {
    "prefix": "if",
    "body": [
      "if ${1:условие} then",
      "\t${2:действие}",
      "fi"
    ],
    "description": "Базовая условная конструкция"
  },
  "Условная конструкция IF-ELSE": {
    "prefix": "ifelse",
    "body": [
      "if ${1:условие} then",
      "\t${2:действие_если_истина}",
      "else",
      "\t${3:действие_если_ложь}",
      "fi"
    ],
    "description": "Условная конструкция с альтернативой"
  },
  "Проверка наличия поля": {
    "prefix": "p",
    "body": [
      "p(v${1:метка})"
    ],
    "description": "Проверка наличия поля в записи"
  },
  "Поле записи": {
    "prefix": "v",
    "body": [
      "v${1:метка}${2:^${3:подполе}}"
    ],
    "description": "Ссылка на поле записи"
  },
  "Глобальная переменная": {
    "prefix": "g",
    "body": [
      "G${1:номер}"
    ],
    "description": "Глобальная переменная"
  },
  "Литерал": {
    "prefix": "lit",
    "body": [
      "'${1:текст}'"
    ],
    "description": "Текстовый литерал"
  },
  "Комментарий": {
    "prefix": "/*",
    "body": [
      "/* ${1:комментарий}",
      "$0"
    ],
    "description": "Комментарий до конца строки"
  },
  "Подключение формата": {
    "prefix": "@",
    "body": [
      "@${1:имя_формата}"
    ],
    "description": "Подключение именованного формата (@name -> name.pft)"
  },
  "Функция UNIFOR полная": {
    "prefix": "unifor",
    "body": [
      "&unifor('${1:код_функции}${2:параметры}')"
    ],
    "description": "Полный вызов функции UNIFOR"
  },
  "Функция UNIFOR короткая": {
    "prefix": "uf",
    "body": [
      "&uf('${1:код_функции}${2:параметры}')"
    ],
    "description": "Короткий вызов функции UNIFOR"
  },
  "Вычисление подформата S": {
    "prefix": "s",
    "body": [
      "s(${1:подформат})"
    ],
    "description": "Вычислить подформат и вернуть результат как строку"
  },
  "Числовое значение VAL": {
    "prefix": "val",
    "body": [
      "val(${1:подформат})"
    ],
    "description": "Ведущее числовое значение строки"
  },
  "Форматирование числа F": {
    "prefix": "f",
    "body": [
      "f(${1:выражение},${2:ширина},${3:знаков})"
    ],
    "description": "Форматирование числа с заданной шириной и точностью"
  },
  "Сумма RSUM": {
    "prefix": "rsum",
    "body": [
      "rsum(${1:подформат})"
    ],
    "description": "Сумма чисел, найденных в подформате"
  },
  "Максимум RMAX": {
    "prefix": "rmax",
    "body": [
      "rmax(${1:подформат})"
    ],
    "description": "Максимум чисел, найденных в подформате"
  },
  "Минимум RMIN": {
    "prefix": "rmin",
    "body": [
      "rmin(${1:подформат})"
    ],
    "description": "Минимум чисел, найденных в подформате"
  },
  "Среднее RAVR": {
    "prefix": "ravr",
    "body": [
      "ravr(${1:подформат})"
    ],
    "description": "Среднее чисел, найденных в подформате"
  },
  "Поиск по словарю L": {
    "prefix": "l",
    "body": [
      "l(${1:термин})"
    ],
    "description": "MFN первой записи, найденной по термину словаря"
  },
  "Формат другой записи REF": {
    "prefix": "ref",
    "body": [
      "ref(${1:mfn},${2:формат})"
    ],
    "description": "Применить формат к другой записи по MFN"
  }
}
