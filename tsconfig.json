{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "lib": ["es2015"],
      "types": ["node", "vscode", "mocha"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "out",
      "rootDir": "src",
      "sourceMap": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules"
    ]
  }
