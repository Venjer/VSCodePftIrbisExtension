/* Пример PFT формата для демонстрации возможностей расширения
/* Формат выводит библиографическое описание книги

/* Заглавие с проверкой наличия
if p(v200) then
  v200^a,
  if p(v200^e) then ': ', v200^e fi,
  if p(v200^f) then ' / ', v200^f fi
fi

/* Авторы
if p(v700) then
  ' / ',
  (v700^a,
   if p(v700^b) then ' ', v700^b fi,
   if p(v700^g) then ' ', v700^g fi
   '; ')
fi

/* Издательские данные
if p(v210) then
  '. – ',
  v210^a, ': ', v210^c, ', ', v210^d
fi

/* Физическая характеристика
if p(v215) then
  '. – ', v215^a,
  if p(v215^c) then ': ', v215^c fi,
  if p(v215^d) then '; ', v215^d fi
fi

/* Примеры использования функций UNIFOR

/* Работа со строками
'Длина заглавия: ', &uf('+95', v200^a), ' символов', /

/* Преобразования регистра
'Заглавие прописными: ', &uf('+97', v200^a), /
'Заглавие строчными: ', &uf('Q', v200^a), /

/* Извлечение части строки (первые 10 символов)
'Краткое заглавие: ', &uf('+960*0.10#', v200^a), /

/* Работа с датой
'Дата каталогизации: ', &uf('302'), '.', &uf('301'), '.', &uf('300'), /

/* Подсчет записей с помощью глобальных переменных
&uf('+7W100#1'),
'Номер записи: ', &uf('+7R100'), /

/* Условные конструкции с функциями
if &uf('+95', v200^a) > '50' then
  'Длинное заглавие'
else
  'Короткое заглавие'
fi

/* Работа с полями базы данных
if p(v910^a) then
  'Предметная рубрика: ', v910^a
fi

/* Раскодировка через справочник
if p(v101) then
  'Язык: ', &uf('Klang.mnu\', v101)
fi

/* Получение информации о записи
'Статус записи: ', &uf('+6'), /
'База данных: ', &uf('+D'), /

/* Форматирование связанных документов
if p(v461) then
  'Серия: ', &uf('7SERIES,/S=', v461^t, '/, v461^a')
fi

/* Встроенные функции верхнего уровня
'Число экземпляров: ', &f(&val(v907#1), 3, 0), /
'Сумма цен: ', &rsum(v90^c), /
'Подключаемый формат: ', @brief
