{
  "name": "irbis-pft",
  "displayName": "Irbis Language Support",
  "description": "Полная поддержка языка IRBIS PFT с библиотекой функций UNIFOR, автодополнением и интеллектуальными подсказками",
  "version": "0.1.2",
  "publisher": "Venjer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Venjer/VSCodePftIrbisExtension.git"
  },
  "bugs": {
    "url": "https://github.com/Venjer/VSCodePftIrbisExtension/issues"
  },
  "homepage": "https://github.com/Venjer/VSCodePftIrbisExtension#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "irbis",
    "pft",
    "unifor",
    "rusmarc",
    "marc",
    "ирбис",
    "библиотека",
    "каталогизация"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "mocha \"out/test/**/*.test.js\"",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "irbis",
        "aliases": [
          "Irbis",
          "irbis"
        ],
        "extensions": [
          ".pft"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "irbis-data",
        "aliases": [
          "Irbis Data"
        ],
        "extensions": [
          ".fst",
          ".mnu",
          ".par",
          ".wss",
          ".stw",
          ".ws",
          ".gbl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "irbis",
        "scopeName": "source.irbis",
        "path": "./syntaxes/irbis.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "irbis",
        "path": "./snippets/irbis.json"
      }
    ],
    "commands": [
      {
        "command": "irbis.showUniforByCategory",
        "title": "Показать функции UNIFOR по категориям",
        "category": "IRBIS"
      }
    ],
    "keybindings": [
      {
        "command": "irbis.showUniforByCategory",
        "key": "ctrl+shift+u",
        "when": "editorTextFocus && editorLangId == irbis"
      },
      {
        "command": "editor.action.formatDocument",
        "key": "ctrl+shift+i",
        "when": "editorTextFocus && editorLangId == irbis"
      }
    ],
    "configurationDefaults": {
      "[irbis]": {
        "files.encoding": "windows1251",
        "files.autoGuessEncoding": false
      },
      "[irbis-data]": {
        "files.encoding": "windows1251",
        "files.autoGuessEncoding": false
      }
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.17.0",
    "mocha": "^11.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
