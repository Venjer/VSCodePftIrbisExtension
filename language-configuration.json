{
    "comments": {
        // В PFT комментарий "/*" действует до конца физической строки, закрывающего "*/" в языке нет.
        "lineComment": "/*"
    },
    // symbols used as brackets
    "brackets": [
        ["(", ")"],
        ["if", "fi"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["|", "|"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["|", "|"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
    ]
}